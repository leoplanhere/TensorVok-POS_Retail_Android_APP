<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="50dp">
    <LinearLayout
        android:background="@drawable/white_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="30dp"
            android:textStyle="bold"
            android:text="@string/shiftover"
            android:layout_marginLeft="20dp"/>




    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <LinearLayout
            android:padding="20dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="2"
            android:background="@drawable/white_bg">
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印交接单\u3000"
                    android:textColor="@color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/jiaojiedan_btn1"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/jiaojiedan_btn1_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@mipmap/checkbox_2"/>
                    <TextView
                        android:id="@+id/jiaojiedan_btn1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="是"
                        android:textSize="25dp"
                        android:textColor="@color/buleshape"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/jiaojiedan_btn2"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/jiaojiedan_btn2_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/gray_line"/>
                    <TextView
                        android:id="@+id/jiaojiedan_btn2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="否"
                        android:textSize="25dp"
                        android:textColor="@color/black"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印份数\u3000\u3000"
                    android:textColor="@color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dayingshu_jian"
                        android:layout_marginLeft="8dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shulian"
                        android:text="-"
                        android:gravity="center"
                        android:textSize="30dp"
                        android:textColor="@color/black"/>
                    <TextView
                        android:id="@+id/dayingshu_tv"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="30dp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/dayingshu_jia"
                        android:layout_marginRight="8dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shulian"
                        android:text="+"
                        android:gravity="center"
                        android:textSize="30dp"
                        android:textColor="@color/black"/>
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印选项\u3000"
                    android:textColor="@color/black"
                    android:textSize="35dp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印类别汇总"
                    android:textColor="@color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/leibie_btn1"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/leibie_btn1_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@mipmap/checkbox_2"/>
                    <TextView
                        android:id="@+id/leibie_btn1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="是"
                        android:textSize="25dp"
                        android:textColor="@color/buleshape"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/leibie_btn2"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/leibie_btn2_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/gray_line"/>
                    <TextView
                        android:id="@+id/leibie_btn2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="否"
                        android:textSize="25dp"
                        android:textColor="@color/black"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印商品汇总"
                    android:textColor="@color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/shangpin_btn1"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/shangpin_btn1_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@mipmap/checkbox_2"/>
                    <TextView
                        android:id="@+id/shangpin_btn1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="是"
                        android:textSize="25dp"
                        android:textColor="@color/buleshape"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/shangpin_btn2"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/shangpin_btn2_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/gray_line"/>
                    <TextView
                        android:id="@+id/shangpin_btn2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="否"
                        android:textSize="25dp"
                        android:textColor="@color/black"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="打印退款汇总"
                    android:textColor="@color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:id="@+id/tuikuan_btn1"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tuikuan_btn1_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@mipmap/checkbox_2"/>
                    <TextView
                        android:id="@+id/tuikuan_btn1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="是"
                        android:textSize="25dp"
                        android:textColor="@color/buleshape"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/tuikuan_btn2"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tuikuan_btn2_c"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/gray_line"/>
                    <TextView
                        android:id="@+id/tuikuan_btn2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="否"
                        android:textSize="25dp"
                        android:textColor="@color/black"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/jiaoban_btn"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/home_blue_bg1"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:text="@string/shiftover"/>


            <TextView
                android:id="@+id/fanhui_btn"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:text="@string/back"
                android:textSize="20dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/black_line1"/>

            
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="8"
            android:background="@drawable/white_bg"
            android:layout_marginLeft="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/No"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/shiftovertime"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="2"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/shouyinyuan"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/total"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/refund"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/TotalDue"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
                <TextView
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/operation"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#ebeef5" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:fadeScrollbars="false"
                android:gravity="center"
                android:scrollbarFadeDuration="0"
                android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                android:scrollbars="vertical"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>