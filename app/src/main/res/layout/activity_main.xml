                                android:layout_marginStart="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="30dp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:text="0.00"/>
