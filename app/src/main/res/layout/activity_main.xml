<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e2e2e2"
    android:orientation="vertical">
    <LinearLayout
        android:padding="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/dp_10"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/white_bg">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/shop_rv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:fadeScrollbars="false"
                android:gravity="center"
                android:scrollbarFadeDuration="0"
                android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                android:scrollbars="vertical"
                android:visibility="visible" />
            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/more_function_btn"
                    android:layout_marginLeft="10dp"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:src="@mipmap/more_function" />
                <LinearLayout
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_alignParentRight="true"
                    android:layout_margin="5dp"
                    android:layout_width="440dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_border"
                    android:orientation="horizontal">
                    <com.uhm.uhmcs.view.CustomInputTextView
                        android:id="@+id/et_tiaoxingma"
                        android:hint="条形码"
                        android:textColorHint="#c1c1c1"
                        android:textSize="24dp"
                        android:textColor="@color/black"
                        android:layout_margin="10dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"/>

                    <ImageView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/jianpan"/>

                </LinearLayout>

            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/white_bg"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/blue_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        android:text="总价"
                        android:textStyle="bold"
                        android:layout_marginLeft="@dimen/dp_10"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mr_red_000"
                        android:textSize="30dp"
                        android:text="￥"
                        android:textStyle="bold"
                        android:layout_marginLeft="@dimen/dp_10"/>
                    <TextView
                        android:id="@+id/tv_zongjia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mr_red_000"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:text="0.00" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/blue_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        android:text="总件数"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/dp_10"/>

                    <TextView
                        android:id="@+id/tv_zongjian"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mr_red_000"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_weight="2">
                    <TextView
                        android:id="@+id/delete_shop"
                        android:background="@drawable/red_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="删除商品"
                        android:textSize="20dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:layout_marginRight="@dimen/dp_10"/>
                    <TextView
                        android:id="@+id/qingkong_btn"
                        android:background="@drawable/red_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="清空(F5)"
                        android:textSize="20dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:layout_marginRight="@dimen/dp_10"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/huiyuan_btn"
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_border">
                    <ImageView
                        android:layout_marginLeft="5dp"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:src="@mipmap/huanyuan"/>
                    <TextView
                        android:id="@+id/huiyuan_name"
                        android:layout_marginLeft="5dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="会员昵称"
                        android:textColor="@color/black"
                        android:textSize="20dp"/>
                    <ImageView
                        android:id="@+id/shanchuhuiyuan_btn"
                        android:layout_marginRight="5dp"
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="match_parent"
                        android:src="@mipmap/shanchu" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/guadan_btn"
                    android:background="@drawable/blue_bg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="挂单(F2)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:id="@+id/qudan_btn"
                    android:background="@drawable/blue_bg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/qudan_null"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:id="@+id/dazhe_one_btn"
                    android:background="@drawable/yellow_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="改价/打折(F4)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:id="@+id/dazhe_all_btn"
                    android:background="@drawable/yellow_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="整单打折(F6)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:id="@+id/daying_btn"
                    android:background="@drawable/black_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="打印尾单(F7)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="5dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/gray_bg1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="序号"/>
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="品名"/>
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="规格"/>
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="数量"/>
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="合计"/>
                    <TextView
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:text="操作"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView

                    android:id="@+id/selected_shop_rv"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadeScrollbars="false"
                    android:gravity="center"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                    android:scrollbars="vertical"
                    android:visibility="visible" />

            </LinearLayout>
            <LinearLayout
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">
                <TextView
                    android:visibility="invisible"
                    android:background="@drawable/blue_bg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="挂单(F2)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:visibility="invisible"
                    android:background="@drawable/blue_bg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="取单(F3)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:visibility="invisible"
                    android:background="@drawable/yellow_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="改价/打折(F4)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:visibility="invisible"
                    android:background="@drawable/yellow_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="整单打折(F6)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginRight="@dimen/dp_10"/>
                <TextView
                    android:id="@+id/checkout_btn"
                    android:background="@drawable/blue_bg1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="结账(F8)"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:background="@color/white"
        android:id="@+id/rv_choose_menu3"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:fadeScrollbars="false"
        android:scrollbarFadeDuration="0"
        android:scrollbarSize="6dp"
        android:scrollbars="horizontal"/>


</LinearLayout>