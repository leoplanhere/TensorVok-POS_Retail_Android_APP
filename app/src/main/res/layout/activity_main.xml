                            android:layout_height="wrap_content"
                            android:textSize="40dp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:text="0.00"/>
                    </LinearLayout>
                    
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
