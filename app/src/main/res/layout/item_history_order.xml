<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="20dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/shouyinyuan_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <TextView
            android:id="@+id/dingdanbianhao_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <TextView
            android:id="@+id/dingdanshijian_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:id="@+id/gouwuxinxi_tv"
                android:layout_width="match_parent"
                android:layout_margin="20dp"
                android:layout_height="50dp"
                android:background="@drawable/rounded_border"
                android:layout_weight="1"
                android:textSize="23dp"
                android:textColor="@color/black"
                android:text="查看"
                android:gravity="center"/>
        </LinearLayout>
        <TextView
            android:id="@+id/youhuijine_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <TextView
            android:id="@+id/zhifujine_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <TextView
            android:id="@+id/zonge_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="23dp"
            android:textColor="@color/black"
            android:text=""
            android:gravity="center"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView

                android:id="@+id/zhifuxinxi_btn"
                android:layout_width="match_parent"
                android:layout_margin="20dp"
                android:layout_height="50dp"
                android:background="@drawable/rounded_border"
                android:layout_weight="1"
                android:textSize="23dp"
                android:textColor="@color/black"
                android:text="查看"
                android:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:id="@+id/daying_tv"
                android:layout_width="match_parent"
                android:layout_margin="20dp"
                android:layout_height="50dp"
                android:background="@drawable/rounded_border"
                android:layout_weight="1"
                android:textSize="23dp"
                android:textColor="@color/black"
                android:text="打印"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ebeef5" />
</LinearLayout>