<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="30dp"
        android:background="@drawable/white_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/shop_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:background="@drawable/black_line"
                android:text="@string/product_selection"
                android:textColor="@color/mr_blue"
                android:textSize="18dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/print_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:background="@drawable/black_line"
                android:text="@string/print"
                android:textColor="@color/black"
                android:textSize="18dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/setting_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:background="@drawable/blue_bg2"
                android:text="标签设置"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/delete_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:background="@drawable/red_bg"
                android:text="@string/delete"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/all_delete_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:background="@drawable/black_line"
                android:text="@string/clear"
                android:textColor="@color/black"
                android:textSize="18dp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/fanhui_btn"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/black_line"
                android:text="@string/back"
                android:textColor="@color/black"
                android:textSize="18dp"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/dqxz_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="right"
            android:text="正在检测打印机..."
            android:textColor="@color/circle_green"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/all_select_btn"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="#F5F5F5">
            <TextView
                android:id="@+id/all_select"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@mipmap/checkbox_1"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="序号"
                android:textColor="@color/black"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="SN"
                android:textColor="@color/black"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="2"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="品名"
                android:textColor="@color/black"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="售价"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="原价"
                android:textColor="@color/black"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="成本价"
                android:textColor="@color/black"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shop_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:scrollbars="vertical" />

    </LinearLayout>
</LinearLayout>