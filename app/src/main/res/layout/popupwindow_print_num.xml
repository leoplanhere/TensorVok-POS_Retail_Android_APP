<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="100dp"
    android:gravity="center"
    android:background="#99000000">

    <LinearLayout
        android:padding="30dp"
        android:layout_width="800dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_bg">

        <RelativeLayout
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="30dp"
                android:text="@string/print_quantity"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/guanbi_btn"
                android:layout_centerVertical="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/guanbi"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red_btn_bg_color"
            android:text="@string/prints_per_item"
            android:textStyle="bold"
            android:textSize="28dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_minus"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:text="-"
                android:textSize="40dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/rounded_border"/>

            <com.uhm.uhmcs.view.CustomInputTextView
                android:id="@+id/print_num"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:textSize="28dp"
                android:text="1"
                android:textColor="@color/black"
                android:gravity="center"
                android:background="@drawable/rounded_border"/>

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="40dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/rounded_border"/>
        </LinearLayout>

        <TextView
            android:id="@+id/print_btn"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="300dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="28dp"
            android:text="@string/start_print"
            android:layout_height="70dp"
            android:background="@drawable/blue_bg1"/>

    </LinearLayout>
</LinearLayout>