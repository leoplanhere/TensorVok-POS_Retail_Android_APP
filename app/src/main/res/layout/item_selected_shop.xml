<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:id="@+id/all_view">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/xuhao"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:text="序号"/>
        <TextView
            android:id="@+id/pinming"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:text="品ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss名"/>
        <TextView
            android:visibility="gone"
            android:id="@+id/guige"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:text="规格"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1.5">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/shuliang_jian"
                    android:layout_marginLeft="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shulian"
                    android:text="-"
                    android:gravity="center"
                    android:textSize="30dp"
                    android:textColor="@color/black"/>
                <TextView
                    android:id="@+id/shuliang"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1231"
                    android:textSize="30dp"
                    android:textColor="@color/black"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/shuliang_jia"
                    android:layout_marginRight="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shulian"
                    android:text="+"
                    android:gravity="center"
                    android:textSize="30dp"
                    android:textColor="@color/black"/>
            </LinearLayout>
            <TextView
                android:id="@+id/zhekou_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="折: 0%"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>
        <TextView
            android:id="@+id/heji"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="30dp"
            android:textColor="@color/black"
            android:text=""/>
        <TextView
            android:layout_marginRight="6dp"
            android:id="@+id/zengsong"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:background="@drawable/blue_bg1"
            android:layout_weight="1"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:text="@string/give_away"/>
    </LinearLayout>
</LinearLayout>