<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_receipt_root"
    android:layout_width="384px"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingBottom="20dp"
    android:paddingLeft="5dp"
    android:paddingRight="5dp">

    <ImageView
        android:id="@+id/iv_top_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="100px"
        android:layout_marginRight="100px"
        android:src="@mipmap/pos_ui_logo_01"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_shop_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="优道佳家福会员超市"
        android:textColor="@color/black"
        android:textSize="32px"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_shop_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="全国客服热线: 17560635652"
        android:textColor="@color/black"
        android:textSize="26px"
        android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_member_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="会员名称: 体验会员"
            android:textColor="@color/black"
            android:textSize="26px"/>

        <TextView
            android:id="@+id/tv_cashier_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="收银员: 001"
            android:textColor="@color/black"
            android:textSize="26px"/>

        <TextView
            android:id="@+id/tv_time_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="收银时间: 2026/01/04 16:09:24"
            android:textColor="@color/black"
            android:textSize="26px"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"
        android:layout_marginTop="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="14" android:layout_height="wrap_content" android:text="商品名称" android:textColor="@color/black" android:textSize="26px" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="数量" android:textColor="@color/black" android:textSize="26px" android:textStyle="bold" android:gravity="end"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="单价" android:textColor="@color/black" android:textSize="26px" android:textStyle="bold" android:gravity="end"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="金额" android:textColor="@color/black" android:textSize="26px" android:textStyle="bold" android:gravity="end"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"/>

    <LinearLayout
        android:id="@+id/ll_goods_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应付总计:" android:textColor="@color/black" android:textSize="26px"/>
            <TextView android:id="@+id/tv_total_amount_label" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="26px"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <TextView android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实付金额:" android:textColor="@color/black" android:textSize="30px" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_total_amount" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="36px" android:textStyle="bold"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <TextView android:id="@+id/tv_pay_name" android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付宝支付:" android:textColor="@color/black" android:textSize="28px"/>
            <TextView android:id="@+id/tv_payment_detail" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="28px"/>
        </RelativeLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="10dp"/>

    <ImageView
        android:id="@+id/iv_qrcode"
        android:layout_width="160px"
        android:layout_height="160px"
        android:layout_gravity="center_horizontal"
        android:scaleType="fitXY"
        android:src="@drawable/gengduo"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/iv_barcode"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20px"
        android:layout_marginRight="20px"
        android:scaleType="fitXY"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_order_sn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3350012601045655511930001"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="22px"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_bottom_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="此单据二维码为开具增值税普通发票\n的唯一凭证，请妥善保管。\n请保留此单据，作为退、换货凭证。"
        android:textColor="@color/black"
        android:textSize="24px"
        android:layout_marginTop="15dp"
        android:lineSpacingExtra="4px"/>

    <ImageView
        android:id="@+id/iv_bottom_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="120px"
        android:layout_marginRight="120px"
        android:src="@mipmap/pos_ui_logo_01"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

</LinearLayout>