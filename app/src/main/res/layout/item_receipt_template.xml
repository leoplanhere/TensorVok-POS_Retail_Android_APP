<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_receipt_root"
    android:layout_width="384px"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingBottom="20dp"
    android:paddingLeft="5dp"
    android:paddingRight="5dp">

    <ImageView
        android:id="@+id/iv_top_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="100px"
        android:layout_marginRight="100px"
        android:src="@mipmap/pos_ui_logo_01"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_shop_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="PosVox Store"
        android:textColor="@color/black"
        android:textSize="18px"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_shop_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tel: 88888888"
        android:textColor="@color/black"
        android:textSize="18px"
        android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_member_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/membershipinfo"
            android:textColor="@color/black"
            android:textSize="14px"/>

        <TextView
            android:id="@+id/tv_cashier_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cashier: 001"
            android:textColor="@color/black"
            android:textSize="14px"/>

        <TextView
            android:id="@+id/tv_time_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Time: 2026/01/04 16:09:24"
            android:textColor="@color/black"
            android:textSize="14px"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"
        android:layout_marginTop="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="14" android:layout_height="wrap_content" android:text="@string/itemname" android:textColor="@color/black" android:textSize="14px" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="@string/qty" android:textColor="@color/black" android:textSize="14px" android:textStyle="bold" android:gravity="end"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="@string/price" android:textColor="@color/black" android:textSize="14px" android:textStyle="bold" android:gravity="end"/>
        <TextView android:layout_width="0dp" android:layout_weight="6" android:layout_height="wrap_content" android:text="@string/subtotal" android:textColor="@color/black" android:textSize="14px" android:textStyle="bold" android:gravity="end"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"/>

    <LinearLayout
        android:id="@+id/ll_goods_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------------------------------------------------"
        android:textColor="@color/black"
        android:gravity="center"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/TotalDue" android:textColor="@color/black" android:textSize="18px"/>
            <TextView android:id="@+id/tv_total_amount_label" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="18px"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <TextView android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/payment_amount" android:textColor="@color/black" android:textSize="18px" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_total_amount" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="18px" android:textStyle="bold"/>
        </RelativeLayout>

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <TextView android:id="@+id/tv_pay_name" android:layout_alignParentLeft="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付宝支付:" android:textColor="@color/black" android:textSize="18px"/>
            <TextView android:id="@+id/tv_payment_detail" android:layout_alignParentRight="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100.00" android:textColor="@color/black" android:textSize="18px"/>
        </RelativeLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="10dp"/>

    <ImageView
        android:id="@+id/iv_qrcode"
        android:layout_width="160px"
        android:layout_height="160px"
        android:layout_gravity="center_horizontal"
        android:scaleType="fitXY"
        android:src="@drawable/gengduo"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/iv_barcode"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20px"
        android:layout_marginRight="20px"
        android:scaleType="fitXY"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_order_sn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3350012601045655511930001"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="14px"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_bottom_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/notessample"
        android:textColor="@color/black"
        android:textSize="14px"
        android:layout_marginTop="15dp"
        android:lineSpacingExtra="4px"/>

    <ImageView
        android:id="@+id/iv_bottom_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="120px"
        android:layout_marginRight="120px"
        android:src="@mipmap/pos_ui_logo_01"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

</LinearLayout>