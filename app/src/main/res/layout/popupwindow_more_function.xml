<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">
    <LinearLayout
        android:padding="20dp"
        android:layout_width="840dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_bg">
        <RelativeLayout
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="30dp"
                android:text="更多功能"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/guanbi_btn"
                android:layout_centerVertical="true"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/guanbi"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/tongbushuju_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="同步数据"
                android:gravity="center"/>
            <TextView
                android:id="@+id/bianqiandaying_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="标签打印"
                android:gravity="center"/>
            <TextView
                android:id="@+id/shangpinruku_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="商品入库"
                android:gravity="center"/>
            <TextView
                android:id="@+id/lishizhangdan_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="历史账单"
                android:gravity="center"/>
            <TextView
                android:id="@+id/tuichudenglv_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="退出登录"
                android:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/qianxiangshezhi_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="钱箱设置"
                android:gravity="center"/>
            <TextView
                android:id="@+id/jiaojieban_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="交接班"
                android:gravity="center"/>
            <TextView
                android:visibility="invisible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="商品入库"
                android:gravity="center"/>
            <TextView
                android:visibility="invisible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="历史账单"
                android:gravity="center"/>
            <TextView
               android:visibility="invisible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="退出登录"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>