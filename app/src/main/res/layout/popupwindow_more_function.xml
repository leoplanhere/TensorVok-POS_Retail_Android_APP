<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:id="@+id/all_view">
    <LinearLayout
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:layout_width="840dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_bg">
        <RelativeLayout
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="30dp"
                android:text="@string/more_features"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/guanbi_btn"
                android:layout_centerVertical="true"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/guanbi"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/tongbushuju_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/sync_data"
                android:gravity="center"/>
            <TextView
                android:id="@+id/bianqiandaying_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/label_printing"
                android:gravity="center"/>
            <TextView
                android:id="@+id/shangpinruku_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/stock_in"
                android:gravity="center"/>
            <TextView
                android:id="@+id/lishizhangdan_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/order_history"
                android:gravity="center"/>
            <TextView
                android:id="@+id/tuichudenglv_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/log_out"
                android:gravity="center"/>
        </LinearLayout>
        <LinearLayout
            android:visibility="visible"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/zhangdandayingji_btn"
                android:visibility="visible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/receipt_printer_setup"
                android:gravity="center"/>
            <TextView
                android:id="@+id/bianqiandayingji_btn"
                android:visibility="visible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="@string/label_printer_setup"
                android:gravity="center"/>
            <TextView
                android:id="@+id/dazhekaiguan_btn"
                android:visibility="visible"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="23dp"
                android:textStyle="bold"
                android:text="@string/discount_toggle"
                android:gravity="center"/>
            <TextView
                android:visibility="visible"
                android:id="@+id/shangpindianji_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold"
                android:text="@string/shangpinkaiguan"
                android:gravity="center"/>
            <TextView
                android:visibility="gone"
                android:id="@+id/zhifushengzhi_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="支付设置"
                android:gravity="center"/>
            <TextView
                android:visibility="visible"
                android:id="@+id/huiyuanchongzhi_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="会员充值"
                android:gravity="center"/>
            <TextView
                android:visibility="gone"
                android:id="@+id/qianxiangshezhi_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="钱箱设置"
                android:gravity="center"/>
            <TextView
                android:visibility="gone"
                android:id="@+id/jiaojieban_btn"
                android:layout_marginRight="10dp"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/blue_bg4"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                android:text="交接班"
                android:gravity="center"/>



        </LinearLayout>
    </LinearLayout>

</LinearLayout>