<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#80000000"
    android:id="@+id/all_view">

    <LinearLayout
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:layout_width="840dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_bg">

        <RelativeLayout
            android:layout_marginBottom="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:text="@string/more_features"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/guanbi_btn"
                android:layout_centerVertical="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/guanbi"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tongbushuju_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/baseline_sync_24"

                android:text="@string/sync_data"

                android:textColor="@color/mr_red_000" />

            <TextView
                android:id="@+id/bianqiandaying_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/outline_aod_tablet_24"
                android:text="@string/label_printing" />

            <TextView
                android:id="@+id/shangpinruku_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/outline_add_ad_24"
                android:text="@string/stock_in" />

            <TextView
                android:id="@+id/lishizhangdan_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/outline_browse_gallery_24"
                android:text="@string/order_history" />

            <TextView
                android:id="@+id/tuichudenglv_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/outline_all_out_24"
                android:textColor="@color/mr_red_000"
                android:text="@string/log_out" />
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/zhangdandayingji_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/baseline_print_24"
                android:text="@string/receipt_printer_setup" />

            <TextView
                android:id="@+id/bianqiandayingji_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawablePadding="-22dp"
                android:drawableTop="@drawable/outline_adf_scanner_24"
                android:text="@string/label_printer_setup" />

            <TextView
                android:id="@+id/dazhekaiguan_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawableTop="@drawable/outline_award_star_24"
                android:text="@string/discount_toggle" />

            <TextView
                android:id="@+id/shangpindianji_btn"
                style="@style/MoreFeatureBtnStyle"
                android:drawableTop="@drawable/outline_blur_off_24"
                android:text="@string/shangpinkaiguan" />

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginRight="10dp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>