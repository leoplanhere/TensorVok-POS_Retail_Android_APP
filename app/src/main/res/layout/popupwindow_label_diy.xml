<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:background="@drawable/white_bg"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="标签编辑器"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提示：输入尺寸应用后，若标签过大画面会自动缩放，不影响打印"
            android:textSize="14sp"
            android:textColor="#666"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"/>

        <FrameLayout
            android:id="@+id/fl_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#11000000"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:id="@+id/layout_preview"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tv_preview_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="优海猫测试店"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:background="#110000FF"/>

                <TextView
                    android:id="@+id/tv_preview_name"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="测试商品名称"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:padding="5dp"
                    android:background="#110000FF"/>

                <TextView
                    android:id="@+id/tv_preview_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="￥88.00"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:padding="5dp"
                    android:background="#110000FF"/>

                <LinearLayout
                    android:id="@+id/layout_barcode_group"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="#110000FF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/iv_preview_barcode"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_preview_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12345678"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>

            </FrameLayout>
        </FrameLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#ccc" android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="宽:"
                android:textColor="@color/black"
                android:textSize="18sp"/>
            <EditText
                android:id="@+id/et_width"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:gravity="center"
                android:text="40"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mm"
                android:textColor="@color/black"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 高:"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginLeft="10dp"/>
            <EditText
                android:id="@+id/et_height"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:gravity="center"
                android:text="30"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mm"
                android:textColor="@color/black"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/btn_apply_size"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:text="应用尺寸"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@color/black"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <CheckBox
                android:id="@+id/cb_shop_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="店名"
                android:textColor="@color/black"/>
            <CheckBox
                android:id="@+id/cb_product_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="品名"
                android:textColor="@color/black"/>
            <CheckBox
                android:id="@+id/cb_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="价格"
                android:textColor="@color/black"/>
            <CheckBox
                android:id="@+id/cb_barcode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="条码"
                android:textColor="@color/black"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="关闭"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:background="@drawable/black_line"
                android:layout_marginRight="10dp"/>
            <TextView
                android:id="@+id/btn_print_preview"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="保存位置并打印"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:background="@color/black"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>