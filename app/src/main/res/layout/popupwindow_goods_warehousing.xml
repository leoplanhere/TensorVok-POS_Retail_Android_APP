<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">
    <LinearLayout
        android:padding="30dp"
        android:layout_width="800dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/white_bg">
        <RelativeLayout
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="30dp"
                android:text="商品入库"
                android:textStyle="bold"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@+id/guanbi_btn"
                android:layout_centerVertical="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@mipmap/guanbi"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="商品条码"
                android:textSize="25dp"
                android:textColor="@color/black"/>
            <com.uhm.uhmcs.view.CustomInputTextView
                android:id="@+id/shangpintiaoma_tv"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/rounded_border"
                android:layout_marginLeft="20dp"
                android:text=""
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:paddingLeft="30dp"
                android:textSize="25dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u3000\u3000商品"
                android:textSize="25dp"
                android:textColor="@color/black"/>
            <TextView
                android:id="@+id/shangpin_tv"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/rounded_border"
                android:layout_marginLeft="20dp"
                android:text=""
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:paddingLeft="30dp"
                android:textSize="25dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="库存数量"
                android:textSize="25dp"
                android:textColor="@color/black"/>
            <com.uhm.uhmcs.view.CustomInputTextView
                android:id="@+id/kuchunshuliang_tv"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/rounded_border"
                android:layout_marginLeft="20dp"
                android:text=""
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:paddingLeft="30dp"
                android:textSize="25dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginBottom="20dp"
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">
            <TextView
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="库存数量"
                android:textSize="25dp"
                android:textColor="@color/black"/>
            <TextView
                android:layout_marginLeft="20dp"
                android:layout_height="80dp"
               android:background="@drawable/blue_bg4"
                android:layout_width="180dp"
                android:textSize="25dp"
                android:textColor="@color/white"
                android:text="立即入库"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>