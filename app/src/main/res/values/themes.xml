<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.UHMCS" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorControlActivated">@color/black</item>
    </style>

    <style name="Theme.UHMCS" parent="Base.Theme.UHMCS" />

    <style name="KeyButtonStyle" parent="KeyButtonStyle.Num" />

    <style name="KeyButtonStyle.Num">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">85dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/bg_key_num</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item> <item name="android:elevation">6dp</item> </style>

    <style name="KeyButtonStyle.Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">85dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:textColor">#606266</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item> </style>

</resources>